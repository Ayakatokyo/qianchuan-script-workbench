{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "analysisId",
    "status",
    "inputHashes",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string"
    },
    "analysisId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "prepared",
        "awaitingModel",
        "draftOnly",
        "completed",
        "blocked",
        "failed"
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "inputHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customerFactsSha256",
        "methodSha256",
        "sourcePackSha256"
      ],
      "properties": {
        "customerFactsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "methodSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourcePackSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "originalTextSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
