{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "analysisId", "operation", "status", "inputHashes", "outputs"],
  "properties": {
    "schemaVersion": {"const": 1}, "runId": {"type": "string"}, "analysisId": {"type": "string"}, "operation": {"const": "analysis"}, "status": {"enum": ["awaitingModel", "completed"]},
    "inputHashes": {"type": "object", "additionalProperties": false, "required": ["sourcePackSha256", "planSha256", "modelInputSha256", "factsSliceSha256", "handoffSha256"], "properties": {"sourcePackSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "modelInputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "factsSliceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "handoffSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "outputs": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string"}, {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}]}}
  }
}
