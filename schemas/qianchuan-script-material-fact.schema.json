{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "materialId",
    "rank",
    "metrics",
    "scriptId",
    "rawText",
    "rawTextSha256",
    "normalizedTextSha256",
    "formula",
    "detail",
    "data",
    "text",
    "completeness",
    "fieldSourceRefs",
    "parseStatus",
    "identityState",
    "selectedAttempt",
    "sourceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "materialId": {
      "type": "string",
      "minLength": 1
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "type": "object"
    },
    "scriptId": {
      "type": "string",
      "minLength": 1
    },
    "rawText": {
      "type": "string"
    },
    "rawTextSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalizedTextSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "formula": {},
    "detail": {},
    "data": {},
    "text": {
      "type": ["string", "null"]
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "formulaLabels", "detailLabels", "structuredData", "transcript"],
      "properties": {
        "text": {"type": "boolean"},
        "formulaLabels": {"type": "boolean"},
        "detailLabels": {"type": "boolean"},
        "structuredData": {"type": "boolean"},
        "transcript": {"type": "boolean"}
      }
    },
    "fieldSourceRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "detail", "data", "text"],
      "properties": {
        "formula": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "detail": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "data": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "text": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "parseStatus": {
      "enum": ["parsed", "missing"]
    },
    "identityState": {
      "const": "matched"
    },
    "selectedAttempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
