{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "analysisId", "operation", "requestText", "factsSlice", "outputSchema", "nonCausalBoundary"],
  "properties": {
    "schemaVersion": {"const": 1}, "runId": {"type": "string"}, "analysisId": {"type": "string"}, "operation": {"const": "analysis"},
    "requestText": {"type": "string", "minLength": 1}, "factsSlice": {"type": "object", "required": ["runId", "analysisId", "operation", "materials", "sourcePackSha256"], "properties": {"runId": {"type": "string"}, "analysisId": {"type": "string"}, "operation": {"const": "analysis"}, "materials": {"type": "array", "minItems": 1}, "sourcePackSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "outputSchema": {"const": "script-analysis-result.schema.json"}, "nonCausalBoundary": {"type": "string", "minLength": 1}
  }
}
