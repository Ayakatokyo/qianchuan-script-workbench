{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "analysisId", "status", "inputHashes", "referenceScripts", "scripts", "checks", "missing", "nonCausalBoundary"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "analysisId": {"type": "string", "minLength": 1},
    "status": {"enum": ["prepared", "awaitingModel", "draftOnly", "completed", "blocked", "failed"]},
    "inputHashes": {"type": "object", "additionalProperties": false, "required": ["customerFactsSha256", "methodSha256", "sourcePackSha256"], "properties": {"customerFactsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "methodSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sourcePackSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "referenceScripts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["scriptId", "materialIds", "sourceRefs"], "properties": {"scriptId": {"type": "string"}, "materialIds": {"type": "array", "items": {"type": "string"}}, "sourceRefs": {"type": "array", "items": {"type": "string"}}}}},
    "scripts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "primaryVariable", "text", "claims", "referenceRefs", "review"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "primaryVariable": {"type": "string"}, "text": {"type": "string", "minLength": 1}, "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["text", "customerFactRefs"], "properties": {"text": {"type": "string"}, "customerFactRefs": {"type": "array", "items": {"type": "string"}}}}}, "referenceRefs": {"type": "array", "items": {"type": "string"}}, "hookType": {"enum": ["pain", "mechanism", "pet-story"]}, "sellingPointMappings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["customerFactRef", "expression", "shotIds"], "properties": {"customerFactRef": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1}, "shotIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}, "shots": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["shotId", "segment", "startSec", "endSec", "visual", "voiceover", "subtitle", "audio"], "properties": {"shotId": {"type": "string", "minLength": 1}, "segment": {"enum": ["hook", "product", "proof", "cta"]}, "startSec": {"type": "number", "minimum": 0}, "endSec": {"type": "number", "exclusiveMinimum": 0}, "visual": {"type": "string", "minLength": 1}, "voiceover": {"type": "string", "minLength": 1}, "subtitle": {"type": "string", "minLength": 1}, "audio": {"type": "string", "minLength": 1}}}}, "review": {"type": "object", "additionalProperties": false, "required": ["issues", "humanReviewRequired"], "properties": {"issues": {"type": "array", "items": {"type": "string"}}, "humanReviewRequired": {"type": "boolean"}}}, "referenceAnalysisRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referenceAnalysisCitation"}}}}},
    "referenceLearnings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["referenceRef", "technique", "adaptation", "evidenceScope"], "properties": {"referenceRef": {"type": "string", "minLength": 1}, "technique": {"type": "string", "minLength": 1}, "adaptation": {"type": "string", "minLength": 1}, "evidenceScope": {"const": "textOnly"}}}},
    "checks": {"type": "object", "additionalProperties": false, "required": ["customerFactsComplete", "referencesAvailable", "constraintsPassed"], "properties": {"customerFactsComplete": {"type": "boolean"}, "referencesAvailable": {"type": "boolean"}, "constraintsPassed": {"type": "boolean"}}},
    "missing": {"type": "array", "items": {"type": "string"}},
    "nonCausalBoundary": {"type": "string", "minLength": 1},
    "referenceAnalyses": {"type": "array", "items": {"$ref": "#/$defs/referenceAnalysis"}}
  },
  "$defs": {
    "comparison": {"type": "object", "additionalProperties": false, "required": ["alignment", "platformBasis", "transcriptBasis", "modelInference"], "properties": {"alignment": {"enum": ["aligned", "partiallyAligned", "divergent", "unclear", "textOnly"]}, "platformBasis": {"type": "string", "minLength": 1}, "transcriptBasis": {"type": "string", "minLength": 1}, "modelInference": {"type": "string", "minLength": 1}}},
    "materialReferenceAnalysis": {"type": "object", "additionalProperties": false, "required": ["materialId", "evidenceMode", "platformObservations", "comparison", "borrowableMethod", "fieldSources"], "properties": {"materialId": {"type": "string", "minLength": 1}, "evidenceMode": {"enum": ["structuredAndText", "textOnly"]}, "platformObservations": {"type": "object", "additionalProperties": false, "required": ["formula", "detail", "data", "transcript"], "properties": {"formula": {"type": ["string", "null"]}, "detail": {"type": ["string", "null"]}, "data": {"type": ["string", "null"]}, "transcript": {"type": "string", "minLength": 1}}}, "comparison": {"type": "object", "additionalProperties": false, "required": ["opening", "sellingPointProgression", "evidence", "callToAction"], "properties": {"opening": {"$ref": "#/$defs/comparison"}, "sellingPointProgression": {"$ref": "#/$defs/comparison"}, "evidence": {"$ref": "#/$defs/comparison"}, "callToAction": {"$ref": "#/$defs/comparison"}}}, "borrowableMethod": {"type": "string", "minLength": 1}, "fieldSources": {"type": "object", "additionalProperties": false, "required": ["formula", "detail", "data", "text"], "properties": {"formula": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "detail": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "data": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "text": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}},
    "referenceAnalysis": {"type": "object", "additionalProperties": false, "required": ["referenceRef", "materialAnalyses"], "properties": {"referenceRef": {"type": "string", "minLength": 1}, "materialAnalyses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/materialReferenceAnalysis"}}}},
    "referenceAnalysisCitation": {"type": "object", "additionalProperties": false, "required": ["referenceRef", "materialId"], "properties": {"referenceRef": {"type": "string", "minLength": 1}, "materialId": {"type": "string", "minLength": 1}}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"checks": {"properties": {"customerFactsComplete": {"const": true}, "referencesAvailable": {"const": true}, "constraintsPassed": {"const": true}}}, "scripts": {"items": {"properties": {"claims": {"items": {"properties": {"customerFactRefs": {"minItems": 1}}}}, "referenceRefs": {"minItems": 1}}}}}}}]
}
