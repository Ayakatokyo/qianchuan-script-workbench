{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "analysisId", "operation", "sourcePackSha256", "planSha256", "modelInputSha256", "conclusions", "limitations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "analysisId": {"type": "string", "minLength": 1},
    "operation": {"const": "analysis"},
    "status": {"const": "completed"},
    "sourcePackSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "modelInputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "conclusions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conclusion"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId", "field", "sourceRefs"],
      "properties": {
        "materialId": {"type": "string", "minLength": 1},
        "field": {"enum": ["formula", "detail", "data", "text", "metric", "detailRecord"]},
        "fieldId": {"type": "string"},
        "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"field": {"enum": ["metric", "detailRecord"]}}, "required": ["field"]}, "then": {"required": ["fieldId"]}},
        {"if": {"properties": {"field": {"enum": ["formula", "detail", "data", "text"]}}, "required": ["field"]}, "then": {"not": {"required": ["fieldId"]}}}
      ]
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "classification", "evidenceRefs"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "classification": {"enum": ["platformFact", "textObservation", "modelInference", "customerFact", "suggestion"]},
        "evidenceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    }
  }
}
